/*
 * T600x Thunderbolt PCIe (PCIe-C) DART tunables, included in each
 * apciec[0-2] DART node. iBoot adds "dart-tunables-instance-0" to the ADT
 * at boot, but m1n1 does not copy it for these DARTs, and the DART cannot
 * probe without it. Values read from a J314s ADT, identical for all three
 * ports. Offsets are relative to the DART's reg.
 */
apple,tunable = <0x20c 0xff000007 0xec000007>,
		<0x220 0x000f0f0f 0x000f0f0f>,
		<0x224 0x00ffffff 0x00080808>;
